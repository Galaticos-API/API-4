import assert from "node:assert/strict";
import { createRequire } from "node:module";
import { createServer } from "node:http";
import { randomUUID } from "node:crypto";
import { resolve } from "node:path";
import { mkdir } from "node:fs/promises";
const require = createRequire(import.meta.url);
const { chromium } = require("../../e2e/node_modules/playwright-core");
const { preview } = await import("../../frontend/node_modules/vite/dist/node/index.js");

const embeddings=createServer(async(req,res)=>{for await(const _ of req){} res.setHeader("Content-Type","application/json");res.end(JSON.stringify({embedding:Array(1024).fill(0.1)}));});
await new Promise<void>(r=>embeddings.listen(0,"127.0.0.1",r));
process.env.AI_SERVICE_URL="http://127.0.0.1:"+(embeddings.address() as {port:number}).port;
const {pool}=await import("../src/database/db.js");
const {app}=await import("../src/app.js");
const {sessionService}=await import("../src/modules/auth/session.service.js");
const [project,doc,epic,feature,pbi,admin]=Array.from({length:6},()=>randomUUID());
const chunkIds=Array.from({length:25},()=>randomUUID());
const api=app.listen(0,"127.0.0.1");
await new Promise<void>(r=>api.once("listening",r));
let web: Awaited<ReturnType<typeof preview>>|undefined;
let browser: any;
try {
  await pool.query("INSERT INTO projeto(id,nome,cliente,status) VALUES($1,'Projeto Demonstração S2-08','Dados sintéticos','ativo')",[project]);
  await pool.query("INSERT INTO usuario(id,nome,email,senha_hash,role) VALUES($1::uuid,'Demonstração',$1::text||'@example.test','sintetico','admin')",[admin]);
  await pool.query("INSERT INTO epico(id,projeto_id,titulo,status) VALUES($1,$2,'Segurança','concluido')",[epic,project]);
  await pool.query("INSERT INTO feature(id,epico_id,titulo,status) VALUES($1,$2,'Autenticação','concluido')",[feature,epic]);
  await pool.query("INSERT INTO pbi(id,feature_id,codigo,titulo,historia_como_um,historia_eu_quero,historia_para_que,status) VALUES($1,$2,'PBI-408','Consultar segurança do acervo','PO','consultar segurança','preservar o projeto','concluido')",[pbi,feature]);
  await pool.query("INSERT INTO documento(id,projeto_id,nome,caminho,status_processamento) VALUES($1,$2,'Especificação.pdf','sintetico','processado')",[doc,project]);
  for(let i=0;i<25;i++)await pool.query("INSERT INTO chunk(id,projeto_id,entidade_tipo,entidade_id,texto,embedding,metadados_json) VALUES($1,$2,'documento',$3,$4,$5::vector,$6)",[chunkIds[i],project,doc,i===23?"A integração PIX deve registrar a confirmação de pagamento no projeto de origem.":"Texto sintético do documento, seção "+(i+1),JSON.stringify(Array(1024).fill(0.1)),JSON.stringify({chunk_index:i,source_name:"Especificação.pdf",source_locator:i===23?"DOC-23":""})]);
  await pool.query("INSERT INTO chunk(projeto_id,entidade_tipo,entidade_id,texto,embedding,metadados_json) VALUES($1,'pbi',$2,'Título: Consultar segurança do acervo',$3::vector,$4)",[project,pbi,JSON.stringify(Array(1024).fill(0.1)),JSON.stringify({source_locator:"PBI-408"})]);
  const session=await sessionService.createSession(admin);
  web=await preview({root:resolve("../frontend"),configFile:false,preview:{host:"127.0.0.1",port:5188,strictPort:true,proxy:{"/api":{target:"http://127.0.0.1:"+(api.address() as {port:number}).port,changeOrigin:true}}}});
  browser=await chromium.launch({headless:true,...(process.env.E2E_CHROME_PATH ? {executablePath:process.env.E2E_CHROME_PATH} : {channel:"msedge"})});
  const page=await browser.newPage({viewport:{width:1440,height:1000}});
  const errors:string[]=[];
  page.on("pageerror",(error:Error)=>errors.push(error.message));
  await page.addInitScript((token:string)=>localStorage.setItem("app_auth_token",token),session.token);
  await page.goto("http://127.0.0.1:5188/knowledge");
  await page.getByRole("option",{name:"Projeto Demonstração S2-08"}).waitFor({state:"attached"});
  await page.getByLabel("Escopo do projeto").selectOption(project);
  await page.getByLabel("Nível",{exact:true}).selectOption("documento");
  await page.getByLabel("Pesquisar no acervo").fill("DOC-23");
  await page.getByRole("button",{name:"Pesquisar",exact:true}).click();
  await page.getByRole("button",{name:"Abrir documento no trecho"}).waitFor();
  const artifacts=resolve("../docs/evidence");
  await mkdir(artifacts,{recursive:true});
  await page.screenshot({path:resolve(artifacts,"S2-08-busca.png"),fullPage:true});
  await page.getByRole("button",{name:"Abrir documento no trecho"}).click();
  await page.getByRole("heading",{name:"Trecho 24 · Resultado selecionado"}).waitFor();
  assert.equal(await page.locator("#source-chunk-"+chunkIds[23]).evaluate((node:HTMLElement)=>document.activeElement===node),true);
  await page.getByRole("button",{name:"Trechos anteriores"}).click();
  await page.getByRole("heading",{name:"Trecho 1",exact:true}).waitFor();
  await page.getByRole("button",{name:"Próximos trechos"}).click();
  await page.getByRole("heading",{name:"Trecho 24 · Resultado selecionado"}).waitFor();
  await page.screenshot({path:resolve(artifacts,"S2-08-documento.png"),fullPage:true});
  await page.keyboard.press("Escape");
  assert.equal(await page.getByRole("button",{name:"Abrir documento no trecho"}).evaluate((node:HTMLElement)=>document.activeElement===node),true);
  await page.setViewportSize({width:390,height:844});
  assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth<=window.innerWidth),true);
  await page.screenshot({path:resolve(artifacts,"S2-08-mobile.png"),fullPage:true});
  await page.getByLabel("Nível",{exact:true}).selectOption("decisao");
  await page.getByRole("button",{name:"Pesquisar",exact:true}).click();
  await page.getByRole("heading",{name:"Nenhum resultado encontrado"}).waitFor();
  await page.route("**/api/v1/search?**",route=>route.fulfill({status:503,contentType:"application/json",body:JSON.stringify({error:"Busca temporariamente indisponível."})}));
  await page.getByRole("button",{name:"Pesquisar",exact:true}).click();
  await page.getByRole("alert").filter({hasText:"Busca temporariamente indisponível"}).waitFor();
  await page.unroute("**/api/v1/search?**");
  await page.getByRole("button",{name:"Tentar busca novamente"}).click();
  await page.getByRole("heading",{name:"Nenhum resultado encontrado"}).waitFor();
  await page.getByLabel("Pesquisar no acervo").fill("PBI-408");
  await page.getByLabel("Nível",{exact:true}).selectOption("pbi");
  await page.getByRole("button",{name:"Pesquisar",exact:true}).click();
  await page.getByRole("link",{name:"Abrir origem"}).click();
  await page.getByRole("heading",{name:/PBI-408.*Consultar segurança do acervo/}).waitFor();
  await page.locator(".knowledge-source-focus").waitFor();
  assert.equal(errors.length,0,errors.join("\n"));
  console.log("Navegador aprovado: busca real, documento no trecho 24, paginação, foco, navegação ao PBI e layout mobile.");
} finally {
  await browser?.close();
  if(web)await new Promise<void>(r=>web!.httpServer.close(()=>r()));
  api.closeAllConnections();await new Promise<void>(r=>api.close(()=>r()));
  embeddings.closeAllConnections();await new Promise<void>(r=>embeddings.close(()=>r()));
  await pool.query("DELETE FROM projeto WHERE id=$1",[project]);
  await pool.query("DELETE FROM usuario WHERE id=$1",[admin]);
  await pool.end();
}
