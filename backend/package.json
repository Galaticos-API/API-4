{
  "name": "sinapse-backend",
  "version": "0.1.0",
  "description": "Backend Node.js para o Sinapse - Base Inteligente de Requisitos",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "seed:validate": "node dist/database/seed.js --validate",
    "seed:apply": "node dist/database/seed.js --apply",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/database/migrate.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.mts",
    "test": "node scripts/test.mjs",
    "test:integration:indexing": "tsx scripts/test-indexing-db.mts",
    "test:integration:harness": "tsx scripts/validate-harness.mts",
    "test:integration:copilot": "tsx scripts/validate-harness.mts --browser",
    "test:integration:review": "tsx scripts/test-browser-qa.mts",
    "audit:security": "npm audit --omit=dev"
  },
  "dependencies": {
    "@types/multer": "^2.3.0",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "pgvector": "^0.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
