# ==============================================================================
# SINAPSE - Variáveis de Ambiente de Desenvolvimento
# Copie este arquivo para .env: cp .env.example .env
# ==============================================================================

# --- Banco de Dados Relacional e Vetorial (PostgreSQL + pgvector) ---
POSTGRES_USER=sinapse
POSTGRES_PASSWORD=sinapse_dev_password
POSTGRES_DB=sinapse
POSTGRES_PORT=5432

# --- Orquestração de Ingestão (n8n) ---
N8N_PORT=5678
N8N_BASE_URL=http://localhost:5678

# Chave compartilhada para criptografia de credenciais do n8n entre a equipe (HT-07)
# OBRIGATÓRIO: Todos os membros da equipe devem usar a mesma chave em dev para garantir compatibilidade
N8N_ENCRYPTION_KEY=sinapse-shared-dev-encryption-key-2026

# Chave da API REST do n8n (necessária para n8n-local-sync)
# Obtenha após subir o n8n em: http://localhost:5678 -> Settings -> API -> Create API Key
# ATENÇÃO: NUNCA comite a chave real no repositório!
N8N_API_KEY=

# --- Runtime de IA e Embeddings Locais (Ollama) ---
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
# Modelos recomendados no PRD (Qwen 2.5 / Llama 3.1 para LLM, bge-m3 para embeddings)
OLLAMA_LLM_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_KEEP_ALIVE=24h

# --- Aplicações e Microsserviços ---
BACKEND_PORT=3001
FRONTEND_PORT=5173
AI_SERVICE_PORT=8000

# --- Configurações Regionais ---
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo


