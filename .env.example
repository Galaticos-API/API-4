# ==============================================================================
# SINAPSE - Variáveis de Ambiente de Desenvolvimento
# Copie este arquivo para .env: cp .env.example .env
# ==============================================================================

# --- Banco de Dados Relacional e Vetorial (PostgreSQL + pgvector) ---
POSTGRES_USER=sinapse
POSTGRES_PASSWORD=sinapse_dev_password
POSTGRES_DB=sinapse
POSTGRES_PORT=55432

# --- Runtime de IA e Embeddings Locais (Ollama) ---
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
# URL usada pelo ai-service quando executado dentro do Docker Compose.
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
# Modelos recomendados no PRD (Qwen 2.5 para LLM, bge-m3 para embeddings)
OLLAMA_LLM_MODEL=qwen2.5:1.5b
OLLAMA_NUM_PREDICT=1024
OLLAMA_NUM_CTX=8192
OLLAMA_FILE_NUM_PREDICT=512
OLLAMA_SYNTHESIS_NUM_PREDICT=3072
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_KEEP_ALIVE=24h

# URL padrão do serviço Python na rede Compose. start-dev.ps1 aponta ambos os
# serviços de IA ao host durante a inicialização nativa no Windows.
REPO_ANALYZER_URL=http://ai-service:8000

# Segredo para o backend autorizar chamadas internas ao endpoint de ingestão de documentos.
# Em dev, o valor abaixo é compartilhado pela equipe. Em produção, gere um aleatório e NUNCA versione.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCUMENT_INGESTION_TOKEN=sinapse-dev-document-ingestion-token-2026

# Similaridade coseno mínima para aceitar candidatos encontrados somente pelo vetor.
SEARCH_MIN_VECTOR_SIMILARITY=0.55
# Ranking textual mínimo para retornar correspondências full-text.
SEARCH_MIN_TEXT_RANK=0.05

# Limites do RepoAnalyzer
ANALYZER_QUICK_FILES=8
ANALYZER_BALANCED_FILES=80
MAX_FILES=1000
ANALYZER_MAX_ACTIVE_RUNS=2
ANALYZER_MAX_QUEUED_RUNS=6
ANALYZER_WORKSPACE_QUOTA_MB=2048
MAX_REPO_SIZE_MB=300
ANALYZER_CLONE_MEMORY_MB=512
ANALYZER_CLONE_TIMEOUT_SECONDS=300

# --- Documentos enviados (S1-19/S1-22) ---
# Limite de tamanho por arquivo, aplicado no backend e informado ao cliente.
DOCUMENT_MAX_SIZE_MB=20
# Webhooks de eventos de documentos (deixe vazio para desativar).
DOCUMENT_EVENTS_WEBHOOK_URL=
DOCUMENT_INGEST_WEBHOOK_URL=

# --- Aplicações e Microsserviços ---
BACKEND_PORT=3001
FRONTEND_PORT=5173
AI_SERVICE_PORT=8000
# Endereço de bind da porta do ai-service no host (Docker DNS continua interno)
AI_SERVICE_BIND=127.0.0.1

# --- Configurações Regionais ---
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# Token compartilhado entre o backend Node e o ai-service Python (header X-Service-Token).
# Em DEV, o valor abaixo basta para subir a stack localmente.
# Em PROD, rotacione para um segredo aleatório e NUNCA versione o valor real.
AI_SERVICE_TOKEN=sinapse-dev-ai-service-token
