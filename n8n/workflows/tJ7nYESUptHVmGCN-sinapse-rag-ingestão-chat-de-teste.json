      "id": "4e21b05d-8125-4d4a-9c72-5e3ddbb25bac",
      "name": "Montar e validar chunks",
      "parameters": {
        "jsCode": "const meta = $('Normalizar entrada').first().json;\nconst chunks = $('Chunking (ai-service)').first().json.chunks || [];\nconst embeddings = $input.first().json.embeddings || [];\n\nif (!chunks.length) {\n  throw new Error(`Nenhum chunk gerado para o documento ${meta.documentId}`);\n}\nif (chunks.length !== embeddings.length) {\n  throw new Error(`Chunks (${chunks.length}) e embeddings (${embeddings.length}) divergem`);\n}\nconst bad = embeddings.findIndex(v => !Array.isArray(v) || v.length !== 1024);\nif (bad !== -1) {\n  throw new Error(`Embedding ${bad} n\u00e3o tem 1024 dimens\u00f5es (esperado para bge-m3)`);\n}\n\nconst payload = chunks.map((c, i) => ({\n  chunk_index: c.index ?? i,\n  content: c.content,\n  metadata: { ...(c.metadata || {}), filename: meta.filename },\n  embedding: embeddings[i],\n}));\n\nreturn [{ json: { ...meta, text: undefined, chunks: payload } }];"
      },
