    {
      "id": "18d36a19-ef19-4f8f-8422-c6f5ea6bbb58",
      "name": "Consolidar texto",
      "parameters": {
        "jsCode": "const meta = $('Normalizar entrada').first().json;\nconst items = $input.all();\nlet text = '';\n\nif (meta.extension === 'csv') {\n  const rows = items.map(i => i.json);\n  const headers = Object.keys(rows[0] || {});\n  text = rows\n    .map((r, idx) => `Linha ${idx + 1}: ` + headers.map(h => `${h}: ${r[h]}`).join(' | '))\n    .join('\\n');\n} else {\n  text = items.map(i => i.json.text ?? i.json.data ?? '').join('\\n');\n}\n\nif (!text.trim()) {\n  throw new Error(`Documento ${meta.documentId} sem texto extra\u00edvel`);\n}\n\nreturn [{ json: { ...meta, text } }];"
      },
      "position": [
        2992,
        1712
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
