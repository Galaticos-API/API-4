        "jsCode": "const r = $input.first().json;\nconst sources = r.sources || [];\n\n// Assist\u00eancia estrita: sem evid\u00eancia recuperada, n\u00e3o h\u00e1 resposta.\nif (!sources.length) {\n  return [{ json: { output: 'N\u00e3o encontrei essa informa\u00e7\u00e3o na base de conhecimento deste projeto.' } }];\n}\n\nconst refs = sources\n  .map((s, i) => `[${i + 1}] ${s.filename ?? s.document_id ?? 'fonte'}${s.chunk_index != null ? ' (trecho ' + s.chunk_index + ')' : ''}`)\n  .join('\\n');\n\nreturn [{ json: { output: `${r.answer}\\n\\nFontes:\\n${refs}` } }];"
