      "name": "Resposta HTTP",
      "parameters": {
        "options": {},
        "respondWith": "json",
        "responseBody": "={{ { status: $json.status || 'received', document_id: $json.document_id, total_chunks: $json.total_chunks } }}"
      },
      "position": [
        940,
        300
      ],
