      "name": "Enviar para AI Service",
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/ingest/document",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { document_id: $json.documentId, text_content: $binary.data.toString('utf-8'), project_id: $json.projectId, metadata: { filename: $json.filename, storage_path: $json.storagePath } } }}",
        "options": {
          "timeout": 120000
        }
      },
      "position": [
        710,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
